# Gradle
.gradle/
.kotlin/
build/
!**/src/main/**/build/
!**/src/test/**/build/
gradle-app.setting

# Kotlin / JVM
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# The wrapper is required by CI (.github/workflows/release.yml runs ./gradlew), and the negations must
# come *after* the *.jar rule above or Git keeps ignoring it.
!gradle-wrapper.jar
!gradle-wrapper.properties
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# IDE — IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws
out/

# IDE — VS Code / Cursor
.vscode/
.cursor/

# IDE — Eclipse
.settings/
.classpath
.project
.factorypath
bin/

# IDE — NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# Local environment & secrets
*.env
.env
.env.*
local.properties
secrets.properties

# Logs & temp files
*.log
*.tmp
*.swp
*~
.DS_Store
Thumbs.db

# App runtime data (SQLite lives in ~/.inventory-industry/)
*.db
*.db-journal
*.sqlite
*.sqlite3
