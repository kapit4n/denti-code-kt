    APPOINTMENTS ||--o{ PAYMENTS : "appointment_id"
    PROCEDURE_TYPES ||--o{ PAYMENTS : "procedure_type_id"
    PERFORMED_ACTIONS ||--o{ PAYMENTS : "performed_action_id"

    CONSULTORIES ||--|{ MATERIAL_INVENTORY_LINES : "consultory_id"
    TREATMENT_FACILITIES ||--|{ MATERIAL_INVENTORY_LINES : "facility_id"
