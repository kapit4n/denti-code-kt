    USERS {
        int user_id PK
        string email
        string display_name
        bool is_active
    }

    DOCTORS {
        int doctor_id PK
        int user_id FK
        string first_name
        string last_name
        string specialization
        bool is_active
    }

    PATIENTS {
        int patient_id PK
        int user_id FK
        string first_name
        string last_name
        string contact_phone
        long created_at
    }

    PROCEDURE_TYPES {
        int procedure_type_id PK
        string name
        double standard_price
        bool is_active
    }

    APPOINTMENTS {
        int appointment_id PK
        int patient_id FK
        int primary_doctor_id FK
        string scheduled_at
        string status
        string source
        int follow_up_appointment_id FK
    }

    APPOINTMENT_NOTES {
        int note_id PK
        int appointment_id FK
        string body
        string author_label
    }

    APPOINTMENT_AUDIT_LOG {
        int log_id PK
        int appointment_id FK
        string action
        string actor_label
    }

    PERFORMED_ACTIONS {
        int performed_action_id PK
        int patient_id FK
        int appointment_id FK
        int procedure_type_id FK
        int performing_doctor_id FK
        string status
        double total_price
    }

    PAYMENTS {
        int payment_id PK
        int patient_id FK
        int appointment_id FK
        double amount
        string method
        int performed_action_id FK
    }

    CONSULTORIES {
        int consultory_id PK
        string name
    }

    TREATMENT_FACILITIES {
        int facility_id PK
        string facility_code
        string display_name
    }
