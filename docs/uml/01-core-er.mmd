    APPOINTMENTS ||--|{ PERFORMED_ACTIONS : "appointment_id"
    PROCEDURE_TYPES ||--|{ PERFORMED_ACTIONS : "procedure_type_id"
    DOCTORS ||--|{ PERFORMED_ACTIONS : "performing_doctor_id"

